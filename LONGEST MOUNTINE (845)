class Solution {
public:
    int longestMountain(vector<int>& arr) {
        if(arr.size()<3) return 0;
        int si = 0;
        int i = si + 1;
        int ans = 0;
        while(i < arr.size()){
            if(arr[i]<=arr[i-1]){
                si = i;
                i++;
                continue;
            }
            si = i-1;
            while(i < arr.size() && arr[i]>arr[i-1]) i++;
            if(i==arr.size() || arr[i]==arr[i-1]) continue;
            while(i < arr.size() &&  arr[i]<arr[i-1]) i++;
            ans = max(i-si,ans);
        }
        return ans;
    }
};
